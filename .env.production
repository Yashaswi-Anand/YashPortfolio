# Production build settings (read automatically by react-scripts build).

# Source maps map the minified bundle back to your original, unminified source
# — component names, comments, and anything hard-coded. Shipping them to a
# public host lets anyone reconstruct a browsable copy of src/. Turning this off
# also cuts several MB from the deployed output.
GENERATE_SOURCEMAP=false

# Keep the small webpack runtime as a separate file rather than inlining it into
# index.html, so a strict Content-Security-Policy can be added later without
# needing 'unsafe-inline'.
INLINE_RUNTIME_CHUNK=false
